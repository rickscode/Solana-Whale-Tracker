# Helius (Solana transaction data) - https://helius.dev
HELIUS_API_KEY=

# Supabase - Project Settings > API
# Use the service_role key, not anon: the tables have RLS on with no policies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram - create a bot via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring
POLL_INTERVAL_MS=10000
MIN_BUY_ALERT_USD=300
MIN_SELL_ALERT_USD=300
MAX_PAGES=5
SEED_LOOKBACK_HOURS=24

LOG_LEVEL=info
